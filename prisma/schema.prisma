generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id          String   @id @default(uuid())
  title       String
  description String
  roleType    String
  createdAt   DateTime @default(now())
}

model Candidate {
  id      String @id @default(uuid())
  email   String
  name    String?
  role    String @default("Frontend")  // To make the Ai ask questions based on applicant role
  jobId   String?
  token   String?

  interviews Interview[]
}

model Interview {
  id            String   @id @default(uuid())
  sessionId     String   @unique
  candidateId   String

  role          String?   // optional is fine

  conversation  Json?
  questionCount Int      @default(0)

  score         Int?
  feedback      Json?

  candidate     Candidate @relation(fields: [candidateId], references: [id])
}